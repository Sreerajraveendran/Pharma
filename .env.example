# Copy to .env and replace every value marked CHANGE_ME.
ENVIRONMENT=production
# Set to false to hide /docs and /openapi.json
ENABLE_DOCS=false

# PostgreSQL (the api builds DATABASE_URL from these in docker-compose)
POSTGRES_USER=pharmacore
# Use a long random value made of URL-safe characters (e.g. `openssl rand -hex 24`)
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=pharmacore

# First-run admin: only used while there are no users.
# This password is temporary; the app forces a change on first login.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
BOOTSTRAP_ADMIN_NAME=System Administrator

# Demo data: load sample data into an EMPTY database at startup, and allow the admin
# 'Reset to Demo Data' action (which deletes all business data). Both default to off
# when ENVIRONMENT=production.
SEED_DEMO_DATA=false
ALLOW_DEMO_RESET=false

# Let staff request an account from the login page (admin approval required)
ALLOW_SELF_REGISTRATION=true

# Keep true. Browsers accept Secure cookies on http://localhost; anywhere else, serve over HTTPS.
COOKIE_SECURE=true
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# Only needed if a frontend on a different origin calls the API, e.g. https://app.example.com
# CORS_ORIGINS=
